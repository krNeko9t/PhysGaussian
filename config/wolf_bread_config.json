        "visualize": false
    },

    "objects": [
        {
            "name": "wolf",
            "ply_path": "model/wolf_whitebg-trained/point_cloud/iteration_30000/point_cloud.ply",
            "material": "sand",
            "E": 5e7,
            "nu": 0.3,
            "density": 2000,
            "friction_angle": 30
        },
        {
            "name": "bread",
            "ply_path": "model/bread-trained/point_cloud/iteration_30000/point_cloud.ply",
            "position_offset": [0.0, 0.0, 2.0],
            "material": "jelly",
            "E": 2e3,
            "nu": 0.3,
            "density": 200,
            "particle_filling": {
                "n_grid": 16,
                "density_threshold": 100.0,
