{
    "_comment": "Rigid body test: wolf as a single convex-hull rigid body falling onto a ground plane.",

    "opacity_threshold": 0.02,
    "rotation_degree": [0.0],
    "rotation_axis": [0],

    "substep_dt": 2e-5,
    "frame_dt": 4e-2,
    "frame_num": 80,

    "E": 1e5,
    "nu": 0.3,
    "material": "sand",
    "density": 1000,
    "g": [0.0, 0.0, -9.8],
    "n_grid": 200,

    "boundary_conditions": [
        {
            "type": "surface_collider",
            "point": [1, 1, 0.30],
            "normal": [0.0, 0.0, 1.0],
            "surface": "sticky",
            "friction": 0.5,
            "start_time": 0,
            "end_time": 1e3
        }
    ],

    "newton_rigid": {
        "substep_dt": 1e-2,
        "solver": {
            "iterations": 10
        }
    },

    "mpm_space_vertical_upward_axis": [0, 0, 1],
    "mpm_space_viewpoint_center": [1, 1, 0.8],
    "default_camera_index": -1,
    "show_hint": false,
    "init_azimuthm": 170,
    "init_elevation": 0,
    "init_radius": 1.6,
    "move_camera": true,
    "delta_a": -2.4,
    "delta_e": 0.8,
    "delta_r": 0.0
}
