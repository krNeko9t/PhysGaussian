{
  "_comment": "bench_manual demo: toy simulated as rigid body, wall/floor render-only, world-space plane colliders, procedural orbit camera.",

  "opacity_threshold": 0.1,
  "axis_permutation": "xz-y",
  "rotation_degree": [0.0],
  "rotation_axis": [0],

  "transform_reference": "shared_ply",

  "substep_dt": 1e-4,
  "frame_dt": 1e-2,
  "frame_num": 30,

  "material": "sand",
  "density": 800,
  "g": [0.0, 0.0, -9.8],
  "mu": 0.5,
  "n_grid": 200,

  "objects": [
    {
      "name": "toy",
      "mode": "simulate",
      "ply_path": "bench_manual/toy.ply",
      "position_offset": [0.0, 0.0, 0.1],
      "density": 300,
      "mu": 0.4,
      "initial_velocity": [0.0, 0.0, 2.5]
    },
    {
      "name": "floor",
      "mode": "collider_only",
      "ply_path": "bench_manual/floor.ply",
      "collider": {
        "type": "plane",
        "space": "world",
        "fit": {
          "method": "svd",
          "sample_max": 200000,
          "seed": 0
        },
        "surface": "sticky",
        "friction": 0.6
      }
    },
    {
      "name": "wall",
      "mode": "collider_only",
      "ply_path": "bench_manual/wall.ply",
      "collider": {
        "type": "plane",
        "space": "world",
        "fit": {
          "method": "svd",
          "sample_max": 200000,
          "seed": 0
        },
        "surface": "slip",
        "friction": 0.2
      }
    }
  ],

  "boundary_conditions": [],

  "newton_rigid": {
    "substep_dt": 1e-3,
    "collision_geometry": "convex_hull",
    "use_sdf": true,
    "solver": {
      "iterations": 20,
      "contact_relaxation": 0.5
    }
  },

  "mpm_space_vertical_upward_axis": [0, 0, 1],

  "default_camera_index": -1,
  "show_hint": false,

  "width": 800,
  "height": 600,
  "fovx_deg": 60.0,
  "fovy_deg": 45.0,

  "init_azimuthm": 160.0,
  "init_elevation": 20.0,
  "init_radius": 2.8,
  "move_camera": true,
  "delta_a": -0.6,
  "delta_e": 0.0,
  "delta_r": 0.0
}

